# ─────────────────────────────────────────────────────────────
# agent-gateway 环境配置模板
#   使用：cp .env.example .env，然后按环境修改下面标注的项。
#   绝大多数环境只需改「网络」「路径与权限」「密钥」「端口」四组。
# ─────────────────────────────────────────────────────────────

# ── 1. 网络模式（唯一的环境开关）──────────────────────────────
# direct : 能直连外网（如新加坡服务器）。默认官方镜像源，隧道关闭。
# cn     : 国内网络。默认清华 PyPI + npmmirror，隧道按需开启（需私钥）。
INTERNET_MODE=cn

# 镜像源默认值由 INTERNET_MODE 自动派生（见下方说明）。
# 如需覆盖，取消注释并填写自己的地址：
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com

# 隧道（INTERNET_MODE=cn 且需要 Gemini 中转时才需要）
# 把可用的 ssh 私钥放到 ${DATA_DIR}/hermes/.ssh_tunnel_key 即自动启用；
# 没有私钥时脚本会安全跳过（模型调用可能失败，但容器正常启动）。
# direct 模式下即使有私钥也不会使用。
TUNNEL_ENABLED=0
TUNNEL_HOST=ubuntu@43.156.187.79
TUNNEL_PORT=8899

# ── 2. 路径与权限（所有环境统一）──────────────────────────────
# 所有持久数据根目录，必须是 Linux 本地文件系统（ext4）。
# ★ 绝不能放在 /mnt/d（WSL 9p 会让 SQLite WAL 静默损坏）。
# 本地（WSL）示例：/home/<你的用户名>/agent-gateway/data
# 服务器示例：/github/agent-gateway/data
DATA_DIR=/home/niechao/agent-gateway/data

# 数据目录属主。control 与 hermes 用同一 uid:gid 运行，避免原子写权限错误。
# 本地 WSL 常用 1000:1000；服务器 devops/hermes 用 1002:1003。
DATA_UID=1000
DATA_GID=1000

# 内存限制（可选，留空表示不限制；服务器此前用 1200/384/256/256/64m）
HERMES_MEM_LIMIT=
CONTROL_MEM_LIMIT=
WEB_MEM_LIMIT=
POSTGRES_MEM_LIMIT=
NGINX_MEM_LIMIT=

# ── 3. 密钥（必填，替换默认值）────────────────────────────────
API_SERVER_KEY=change-me-api-server-key
JWT_SECRET=change-me-jwt-secret
POSTGRES_USER=agent_gateway
POSTGRES_DB=agent_gateway
POSTGRES_PASSWORD=change-me-postgres-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Hermes dashboard 三个变量（hermes 的 basic auth provider，控制层用它调 /api/*）
# 注意：不是给浏览器用的 HTTP Basic，而是控制层 POST /auth/password-login 换 cookie。
DASHBOARD_USER=hermes-svc
DASHBOARD_PASSWORD=change-me-dashboard-password
DASHBOARD_SECRET=change-me-dashboard-session-signing-secret

# ── 4. 端口与对外地址 ─────────────────────────────────────────
GATEWAY_PORT=10099
# 对外完整地址（A2A Agent Card / 前端链接需要）。本机可用 http://127.0.0.1:10099
PUBLIC_BASE_URL=http://127.0.0.1:10099

# ── 5. 其他可选 ───────────────────────────────────────────────
TZ=Asia/Shanghai
ALLOW_REGISTRATION=true
SOFT_DELETE_RETENTION_DAYS=30

# ─────────────────────────────────────────────────────────────
# 镜像源派生规则（供 make/compose 使用，勿手改这一段逻辑）：
#   INTERNET_MODE=direct → PIP_INDEX_URL=https://pypi.org/simple
#                          NPM_REGISTRY=https://registry.npmjs.org
#   INTERNET_MODE=cn     → PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#                          NPM_REGISTRY=https://registry.npmmirror.com
# 用户在上面显式设置 PIP_INDEX_URL/NPM_REGISTRY 时，以用户值为准。
# ─────────────────────────────────────────────────────────────

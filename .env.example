# agent-gateway 环境变量模板
# 复制为 .env 后填写：cp .env.example .env
# .env 不要提交到 git

# ─── hermes ───────────────────────────────────────────────
# 容器内 hermes 用户的 uid/gid，必须与数据目录所有者一致
# 查法：在 WSL 里执行 id -u && id -g
HERMES_UID=1000
HERMES_GID=1000

# hermes 数据目录（**必须是 WSL ext4 路径**，不能是 /mnt/c 或 /mnt/d）
# 9p/drvfs 挂载会让 SQLite WAL 静默损坏
HERMES_DATA_DIR=/home/niechao/agent-gateway/data/hermes

# OpenAI 兼容 API server 的密钥，至少 8 字符
# 生成：openssl rand -hex 32
API_SERVER_KEY=

# dashboard 的 basic auth（非 loopback 绑定时必填）
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
DASHBOARD_SECRET=

# ─── 控制层 ───────────────────────────────────────────────
POSTGRES_USER=agent_gateway
POSTGRES_PASSWORD=
POSTGRES_DB=agent_gateway

# postgres 数据目录（同样必须在 ext4 上）
POSTGRES_DATA_DIR=/home/niechao/agent-gateway/data/postgres

# JWT 签名密钥，生成：openssl rand -hex 32
JWT_SECRET=

# 默认管理员（管理中心登录用）
# ⚠️ 生产环境务必改掉
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 是否开放自助注册
ALLOW_REGISTRATION=true

# 软删会话的保留天数，超过后由定时任务硬删
SOFT_DELETE_RETENTION_DAYS=30

# ─── 部署 ─────────────────────────────────────────────────
# nginx 对外端口
GATEWAY_PORT=10099

TZ=Asia/Shanghai
